# Copy to backend/.env for local development. Placeholders only: never commit real values.
# In production these are set in the hosting provider's secret store.

APP_ENV=development

# SQLite locally; Postgres in production, e.g. postgresql+psycopg://user:password@host:5432/salary
DATABASE_URL=sqlite:///./salary.db

# The single HR login. The API refuses to start until all three are set.
# Generate the hash (and a fresh secret) with: python -m app.core.hash_password
HR_ADMIN_EMAIL=hr@example.com
HR_ADMIN_PASSWORD_HASH=replace-with-the-bcrypt-hash-from-the-command-above
SESSION_SECRET=replace-with-at-least-32-random-characters

# Session cookie. Browsers accept Secure cookies on http://localhost; set to false
# only if yours doesn't. Always true in production.
COOKIE_SECURE=true
SESSION_HOURS=8

# Pay changes due within this many days count as exceptions.
PENDING_WINDOW_DAYS=60
