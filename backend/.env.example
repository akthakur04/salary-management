# Copy to backend/.env for local development. Placeholders only: never commit real values.
# In production these are set in the hosting provider's secret store.

APP_ENV=development

# SQLite locally; Postgres in production, e.g. postgresql+psycopg://user:password@host:5432/salary
DATABASE_URL=sqlite:///./salary.db

# HR login (used from Phase 5). The password is stored only as a bcrypt hash.
HR_ADMIN_EMAIL=hr@example.com
HR_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
SESSION_SECRET=replace-with-a-long-random-string
